# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# debug artifacts kept locally only
.playwright-mcp/
*.bak
/stitch_palette_visualizer/

# loose screenshots / scratch in repo root
/*.png
/*.jpg
/*.jpeg

# typescript
*.tsbuildinfo
next-env.d.ts

# data
/data/

# secrets
client_secret_*.json

# routine artifacts (local-only — not source)
/drafts/
/reports/
/docs/blog-calendar.md

# scrape caches (local-only — re-fetchable from manufacturer sites)
/scripts/data/*
# ...except the frozen match-data list and its snapshots, which the build reads
!/scripts/data/frozen-match-sources.json
!/scripts/data/frozen-match/
# ...and the hand-curated inputs from the 2026-11 data audit (docs/data-audit-2026-11.md)
!/scripts/data/explicit-duplicates.json
!/scripts/data/vista-identity-plan.json
!/scripts/data/ral-classic-reference.json
!/scripts/data/audit-2026-11/

# pre-computed match data (regenerated at build time by scripts/build-match-data.ts)
/public/match-data/

# Drift detection runtime data (SQLite)
scripts/drift/*.db
scripts/drift/*.db-shm
scripts/drift/*.db-wal

# Social drip runtime state. The ledgers, logs and reports now live in
# ~/Library/Application Support/PaintColorHQ/social/ (scripts/social/ledger.ts);
# these patterns cover copies left in older checkouts.
scripts/pinterest/published*.json
scripts/pinterest/drip.log
scripts/pinterest/analytics.log
scripts/pinterest/reports/
scripts/pinterest/preview.html
scripts/facebook/fb-published.json
scripts/facebook/drip.log
scripts/instagram/ig-published.json
scripts/instagram/drip.log

# Python bytecode (e.g. the drift compare tooling)
__pycache__/
*.pyc

# SEO audit derived/binary artifacts — keep the markdown reports tracked,
# not the heavy PDF/HTML/screenshot/script outputs (4MB+ per full audit).
seo-audits/**/screenshots/
seo-audits/**/*.pdf
seo-audits/**/*.html
seo-audits/**/*.py

# Session records and roast outputs live in the Brain, not in this PUBLIC repo.
# See brain/projects/paintcolorhq/records/. Committing them here on 2026-08-19
# published revenue and strategy detail by accident.
HANDOFF.md
docs/roast-*.md
docs/research/

# Validated sitemap snapshot generated before dev/build
/src/generated/sitemap.json
/src/generated/sitemap.json.tmp
/src/generated/match-sitemap-pairs.json
/src/generated/match-sitemap-pairs.json.tmp
/src/generated/search-words.json
/src/generated/search-words.json.tmp

# DB row backups from one-off fix scripts (local only, never commit)
scripts/backups/

# visualizer room sources: keep the generated images and settings, not derived output
# (rebuild with scripts/build-room-masks.py, publish with scripts/export-rooms.py)
room-src/*/mask-*.png
room-src/*/render-*.jpg
room-src/*/preview.jpg
room-src/*/report.txt
